def stop_process(p, timeout=8):
    if not p: return
    if p.poll() is None:
        p.terminate()
        try: p.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            p.kill(); p.wait()

def sleep(seconds):
    end=time.monotonic()+seconds
    while not STOP and time.monotonic()<end:
        time.sleep(min(.25, end-time.monotonic()))

def profile(transport, control):
    group=Path('vanilla') if control=='vanilla' else Path('control-protection')/control
    return CLIENT/group/'profiles'/f'{transport}.ovpn'

def parse_profile(path):
    values={}
    for line in path.read_text().splitlines():
        parts=line.split()
        if parts and not parts[0].startswith('#'): values[parts[0]]=parts[1:]
    host,port=values['remote'][:2]
    proto='tcp' if values['proto'][0].startswith('tcp') else 'udp'
    return host,int(port),proto

def plan_schedule(combos, total, per_config, shuffle, rng):
    counts={mode:per_config for mode in combos}
    if total is not None:
        base, extra=divmod(total,len(combos))
        counts={mode:base for mode in combos}
        for mode in rng.sample(combos,extra): counts[mode]+=1
    schedule=[mode for mode in combos for _ in range(counts[mode])]
    if shuffle: rng.shuffle(schedule)
    return schedule,counts

def mixed_rekey_plan(combos, schedule, counts, rng, hold_seconds):
    """Balance 0/1/2 renewal targets within each configuration."""
    per_mode={}
    starts=[i%3 for i in range(len(combos))]
    rng.shuffle(starts)
    for mode, start in zip(combos, starts):
        n=counts[mode]
        targets=[0,1,2]*(n//3)+[(start+j)%3 for j in range(n%3)]
        rng.shuffle(targets)
        per_mode[mode]=iter(targets)
    targets=[next(per_mode[mode]) for mode in schedule]
    intervals={0:None, 1:round(hold_seconds*.75), 2:round(hold_seconds*.5)}
    return targets,[intervals[target] for target in targets]

def result_label(args, mixed_rekeys):
    if args.purpose not in ('auto','standard'): return args.purpose
    if args.transport=='all' and args.control=='all':
        return 'mixed-rekeys' if mixed_rekeys or args.reneg_sec is not None else 'mixed'
    if args.transport=='all': return f'both-{args.control}'
    if args.control=='all': return f'{args.transport}-all'
    return f'{args.transport}-{args.control}'

