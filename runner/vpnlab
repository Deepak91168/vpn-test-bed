def capture_stats(pcap, host):
    out={'packet_count':0,'captured_bytes':0,'pcap_size':pcap.stat().st_size if pcap.exists() else 0,
         'client_to_server_packets':0,'client_to_server_bytes':0,'server_to_client_packets':0,'server_to_client_bytes':0}
    if not pcap.exists() or not out['pcap_size']: return out
    r=cmd(['tcpdump','-nn','-tt','-v','-r',str(pcap)],timeout=60)
    if r.returncode: return out
    sizes=[]; times=[]
    lines=r.stdout.splitlines()
    for j,line in enumerate(lines):
        m=re.match(r'^(\d+\.\d+) IP .*? length (\d+)\)',line)
        if not m: continue
        size=int(m.group(2)); sizes.append(size); times.append(float(m.group(1)))
        out['packet_count']+=1; out['captured_bytes']+=size
        detail=lines[j+1] if j+1<len(lines) else ''
        direction='server_to_client' if re.search(r'^\s*'+re.escape(host)+r'\.',detail) else 'client_to_server'
        out[direction+'_packets']+=1; out[direction+'_bytes']+=size
    if times:
        dur=max(times)-min(times); out['capture_duration_s']=round(dur,3)
        out['packets_per_sec']=round(len(times)/dur,2) if dur else None
        out['bytes_per_sec']=round(sum(sizes)/dur,2) if dur else None
        ss=sorted(sizes)
        def pct(q): return ss[round((len(ss)-1)*q)]
        out['packet_size']={'mean':round(statistics.mean(ss),2),'median':statistics.median(ss),
            'min':ss[0],'max':ss[-1],'p25':pct(.25),'p75':pct(.75),'p90':pct(.9),'p95':pct(.95)}
    return out

