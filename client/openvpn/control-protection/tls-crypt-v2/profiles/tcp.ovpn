client
dev tun
proto tcp-client
remote 10.208.23.185 1194
nobind
ca credentials/ca.crt
cert credentials/client.crt
key credentials/client.key
remote-cert-tls server
data-ciphers AES-256-GCM:AES-128-GCM
data-ciphers-fallback AES-256-GCM
auth SHA256
tls-crypt-v2 credentials/tls-crypt-v2-client.key
verb 3
