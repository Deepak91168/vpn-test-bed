# ============================================================================
# Single source of truth for the experiment. Sourced by run_experiment.sh and
# read by session_controller.py. Nothing below is hard-coded in the scripts.
# ============================================================================

# --- experiment size / reproducibility --------------------------------------
SESSIONS=50
SEED=10                       # empty = random (recorded in manifest); set an int to reproduce

# --- per-session timing (randomized ranges, seconds) ------------------------
SESSION_DURATION_MIN=20
SESSION_DURATION_MAX=180
TRAFFIC_START_DELAY_MIN=1
TRAFFIC_START_DELAY_MAX=2
INTER_SESSION_DELAY_MIN=1
INTER_SESSION_DELAY_MAX=2

# --- traffic shape (randomized) ---------------------------------------------
REQUESTS_MIN=3
REQUESTS_MAX=12
REQUEST_INTERVAL_MIN=1
REQUEST_INTERVAL_MAX=8
REQUEST_TIMEOUT=15

# --- traffic backend: wget (realistic browsing bursts) | curl | browser -----
TRAFFIC_BACKEND=wget
BROWSE_DWELL=20             # only used by the 'browser' backend
PYTHON=/usr/bin/python3

# --- VPN / isolation --------------------------------------------------------
OVPN_CONFIG=./client.ovpn   # remote/proto/port are parsed from this file
NETNS=vpn                   # isolated network namespace name
VPN_DNS=1.1.1.1             # resolver used INSIDE the namespace (through the tunnel)
TUN_UP_TIMEOUT=60           # max seconds to wait for the tunnel to establish

# --- capture ----------------------------------------------------------------
CAPTURE=true
CAPTURE_IFACE=auto          # 'auto' = the NIC that reaches the server

# --- traffic destinations ---------------------------------------------------
SITES_FILE=./sites.txt

# --- output -----------------------------------------------------------------
OUTPUT_DIR=./experiment_out
