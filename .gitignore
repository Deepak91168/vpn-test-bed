# ============================================================================
#  vpn-test-bed  —  root .gitignore
#  Layout:  vpn-test-bed/{vpn-client/{client,openvpn-xor-lab}, vpn-server}
# ============================================================================

# --- XOR obfuscation lab: do NOT push ---------------------------------------
openvpn-xor-lab/

# --- Secrets & credentials: NEVER commit (back up separately, see KEYS.md) ---
#   covers ca.crt, server.crt, client.crt, server.key, client.key, dh.pem, ta.key
*.key
*.crt
*.pem
ta.key

# --- Inline-cert OpenVPN profiles (these embed private keys) -----------------
*android*.ovpn

# NOTE: server.conf and client.ovpn ARE committed (they only reference cert
# files by name, no secrets inline). If yours ever contain inline <ca>/<cert>/
# <key>/<tls-auth> blocks, uncomment the next two lines to keep them out:
# server.conf
# client.ovpn

# --- Logs -------------------------------------------------------------------
*.log
openvpn-status.log

# --- Experiment output (large, fully regenerated by a run) ------------------
experiment_out/
**/experiment_out/
*.pcap
run.out

# --- Python / OS cruft ------------------------------------------------------
__pycache__/
*.pyc
.DS_Store
