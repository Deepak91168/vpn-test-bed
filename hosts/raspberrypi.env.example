# Copy to raspberrypi.env. These values use the current desktop VPN exit network.
# The proxy must allow HTTPS CONNECT and be authenticated before web visits can succeed.
# Empty WEB_PROXY means a direct web connection through the VPN, with no proxy fallback.
VPN_DNS=10.208.20.2
WEB_PROXY=http://proxy21.iitd.ac.in:3128
# Optional: SSH_IDENTITY=/path/to/your/ssh/private_key
